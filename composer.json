{
  "name": "bricebou/gis",
  "type": "grav-plugin",
  "description": "This plugin, using the Leaflet javascript library, aims to provide a simple way to geolocate contents and to display interactive maps.",
  "keywords": ["plugin"],
  "homepage": "https://github.com/bricebou/grav-plugin-gis",
  "license": "MIT",
  "authors": [
    {
      "name": "Brice Boucard",
      "email": "brice@reclic.dev",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.3"
  },
  "autoload": {
    "psr-4": {
      "Grav\\Plugin\\Gis\\": "classes/"
    },
    "classmap":  ["gis.php"]
  },
  "scripts": {
    "tools": "composer --working-dir=tools install",
    "ecs": "tools/vendor/bin/ecs check --fix",
    "ecs:check": "tools/vendor/bin/ecs check",
    "rector": "tools/vendor/bin/rector process",
    "rector:check": "tools/vendor/bin/rector process --dry-run",
    "phpstan": "tools/vendor/bin/phpstan analyse --memory-limit=1G",
    "check": [
      "@rector:check",
      "@ecs:check",
      "@phpstan"
    ]
  },
  "config": {
    "platform": {
      "php": "8.3"
    }
  }
}
